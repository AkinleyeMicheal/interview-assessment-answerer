# Groq Vision: image extraction followed by Groq Compound web verification.
GROQ_API_KEY=your_groq_api_key

# Gemini Vision: direct image analysis. Extra keys are used after rate limits.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
MODEL_NAME=gemini-3.8-flash

# Persisted default for the two phone-interface tabs.
OCR_MODE=groq_vision

# The selected desktop rectangle (set from the app, not normally edited here).
SCREEN_REGION_LEFT=0
SCREEN_REGION_TOP=0
SCREEN_REGION_RIGHT=0
SCREEN_REGION_BOTTOM=0
